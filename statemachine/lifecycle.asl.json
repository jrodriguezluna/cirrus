{
  "Comment": "Cirrus - ciclo de vida de un secreto",
  "StartAt": "WaitForRead",
  "States": {
    "WaitForRead": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${LifecycleFnArn}",
        "Payload": {
          "action": "register",
          "id.$": "$.id",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.waitSeconds",
      "ResultPath": "$.readResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.error", "Next": "NotifyExpired" }
      ],
      "Next": "NotifyRead"
    },
    "NotifyRead": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LifecycleFnArn}",
        "Payload": { "action": "notifyRead", "id.$": "$.id" }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "RotationOnRead"
    },
    "RotationOnRead": {
      "Type": "Choice",
      "Comment": "Sin rotación el ciclo termina tras el aviso. Las ejecuciones sin el campo (anteriores a esta opción) siguen con recordatorios.",
      "Choices": [
        { "Variable": "$.rotate", "IsPresent": false, "Next": "WaitReminder" },
        { "Variable": "$.rotate", "BooleanEquals": true, "Next": "WaitReminder" }
      ],
      "Default": "Closed"
    },
    "NotifyExpired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LifecycleFnArn}",
        "Payload": { "action": "notifyExpired", "id.$": "$.id" }
      },
      "ResultSelector": { "reads.$": "$.Payload.reads" },
      "ResultPath": "$.expired",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ReadBeforeExpiry"
    },
    "ReadBeforeExpiry": {
      "Type": "Choice",
      "Comment": "Solo hay recordatorios si se leyó y se pidió rotación. Las reglas van separadas y en orden para no evaluar $.rotate cuando no existe.",
      "Choices": [
        { "Variable": "$.expired.reads", "NumericLessThanEquals": 0, "Next": "Closed" },
        { "Variable": "$.rotate", "IsPresent": false, "Next": "WaitReminder" },
        { "Variable": "$.rotate", "BooleanEquals": true, "Next": "WaitReminder" }
      ],
      "Default": "Closed"
    },
    "WaitReminder": {
      "Type": "Wait",
      "SecondsPath": "$.reminderWait",
      "Next": "CheckAck"
    },
    "CheckAck": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LifecycleFnArn}",
        "Payload": { "action": "checkAck", "id.$": "$.id" }
      },
      "ResultSelector": {
        "acked.$": "$.Payload.acked",
        "attempts.$": "$.Payload.attempts"
      },
      "ResultPath": "$.check",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "IsAcked"
    },
    "IsAcked": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.check.acked", "BooleanEquals": true, "Next": "Closed" },
        { "Variable": "$.check.attempts", "NumericGreaterThanEquals": 3, "Next": "GiveUp" }
      ],
      "Default": "SendReminder"
    },
    "SendReminder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LifecycleFnArn}",
        "Payload": { "action": "sendReminder", "id.$": "$.id" }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitReminder"
    },
    "GiveUp": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LifecycleFnArn}",
        "Payload": { "action": "giveUp", "id.$": "$.id" }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Closed"
    },
    "Closed": { "Type": "Succeed" }
  }
}
