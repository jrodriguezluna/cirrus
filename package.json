{
  "name": "cirrus",
  "private": true,
  "type": "module",
  "description": "Cirrus: secretos de un solo uso con ciclo de vida. Este package.json solo sirve para pruebas y desarrollo local; las Lambdas se empaquetan desde src/*/ con sam build.",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:ui": "node --test --test-concurrency=1 \"test/ui/*.test.mjs\"",
    "test:all": "npm test && npm run test:ui",
    "dev:web": "node test/helpers/dev-server.mjs",
    "preview:emails": "node test/helpers/preview-emails.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "puppeteer-core": "^25.17.0"
  }
}
